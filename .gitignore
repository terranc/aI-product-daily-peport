.codex/
.agents/
.opencode/
.claude/

# Trellis runtime and cache
.trellis/.runtime/
.trellis/scripts/common/__pycache__/

# Python cache
__pycache__/
*.pyc
*.pyo

# Temporary crawl/analysis data (may contain URL patterns that trigger secret scanning)
data/raw-candidates.json
data/deduped-candidates.json
data/selected_products_temp.json
data/_cron_*

# Cron 临时脚本（每次运行自动生成，不应入库）
# 命名不固定：_cron_step*.py / _cron_analyze.py / _step1_dedup.py / _list_candidates.py 都出现过，
# 所以用「下划线开头的下划线分隔临时名」宽匹配；_paths.py 例外，它是被其他脚本 import 的正式模块。
scripts/_cron_*
scripts/_step*
scripts/_list*
scripts/_analyze*
scripts/_tmp*
scripts/_scratch*
scripts/_selected_products.json

scripts/_prefiltered_out.json
scripts/selfcheck_*
